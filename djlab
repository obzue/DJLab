/* Turntable artwork uses square, shared source coordinates for every skin layer. */
.deck:not(.turntable-mode) .jog-row {
  overflow: visible;
}

.deck:not(.turntable-mode) .jog-row .jog {
  transform: scale(1.22) rotate(var(--jog-angle, 0deg));
  transform-origin: 50% 50%;
}

.jog-light {
  inset: -4px;
  border: 0;
  background: transparent;
  -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
  mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
  transform: rotate(calc(0deg - var(--jog-angle, 0deg)));
  animation: none !important;
  filter: none;
}

.deck .jog.spinning .jog-light,
.deck .jog.dragging .jog-light {
  background: conic-gradient(from 0deg, var(--turntable-skin-accent, var(--hardware-accent, var(--cyan))) 0deg 355deg, transparent 355deg 360deg);
  filter: drop-shadow(0 0 5px var(--turntable-skin-accent, var(--hardware-accent, var(--cyan))));
  animation: none !important;
  transform: rotate(calc(0deg - var(--jog-angle, 0deg)));
}

.deck.turntable-mode .jog-row {
  overflow: visible;
}

.deck.turntable-mode .jog-row .jog-light {
  display: block !important;
  inset: 2%;
  z-index: 3;
}
.deck.turntable-mode .jog-row .jog-wrap {
  position: relative;
  width: min(100%, 30vh, 320px);
  height: auto;
  max-width: 100%;
  max-height: 100%;
  aspect-ratio: 1;
  isolation: isolate;
  justify-self: center;
  align-self: center;
}

.deck.turntable-mode .turntable-base-mesh {
  display: block;
  position: absolute;
  inset: 0;
  z-index: 0;
  background-image: var(--turntable-base-image);
  background-position: center;
  background-size: 100% 100%;
  background-repeat: no-repeat;
  -webkit-mask-image: url('./assets/turntables/masks/record-visible.png');
  mask-image: url('./assets/turntables/masks/record-visible.png');
  -webkit-mask-size: 100% 100%;
  mask-size: 100% 100%;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  pointer-events: none;
}

.deck.turntable-mode .jog-row .turntable-platter-mesh {
  position: absolute;
  left: 45.4%;
  top: 52.1%;
  z-index: 1;
  width: 69%;
  height: 69%;
  min-width: 0;
  aspect-ratio: 1;
  border: 0;
  border-radius: 50%;
  overflow: hidden;
  background-color: transparent;
  background-image: var(--turntable-disc);
  background-position: center;
  background-size: 100% 100%;
  background-repeat: no-repeat;
  box-shadow: none;
  transform: translate(-50%, -50%) rotate(var(--jog-angle, 0deg));
  transform-origin: 50% 50%;
  transition: none !important;
  animation: none !important;
  will-change: transform;
}

.deck.turntable-mode .jog.spinning {
  animation: none !important;
}

.deck.turntable-mode .turntable-arm-mesh {
  display: block;
  position: absolute;
  inset: 0;
  z-index: 2;
  background-image: var(--turntable-arm-image);
  background-position: center;
  background-size: 100% 100%;
  background-repeat: no-repeat;
  -webkit-mask-image: var(--turntable-arm-mask);
  mask-image: var(--turntable-arm-mask);
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: 100% 100%;
  mask-size: 100% 100%;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  transform: rotate(var(--tonearm-angle, 0deg));
  transform-origin: var(--tonearm-pivot, 78.8% 25.7%);
  transition: opacity 0.18s ease;
  will-change: transform;
  backface-visibility: hidden;
  pointer-events: none;
}

.deck.turntable-mode:not(.has-track) .turntable-arm-mesh {
  display: none !important;
}

.deck.turntable-mode .turntable-arm-mesh i {
  display: block;
  position: absolute;
  left: 76%;
  top: 20%;
  width: 12%;
  height: 56%;
  opacity: 0;
  pointer-events: auto;
}

.deck.turntable-mode .turntable-arm-mesh b,
.deck.turntable-mode .turntable-arm-mesh em,
.deck.turntable-mode .turntable-arm-mesh i::after {
  display: none !important;
}

.deck.turntable-mode .turntable-record {
  display: none !important;
}

.turntable-preview-deck {
  width: min(100%, 38vh, 390px);
  aspect-ratio: 1;
}

.turntable-preview-deck .turntable-preview-disc {
  background-size: 100% 100%;
  background-repeat: no-repeat;
}

@media (max-height: 650px) {
  .deck.turntable-mode .jog-row .jog-wrap {
    width: min(100%, 34vh, 280px);
    height: auto;
  }
}

.channel.armed {
  position: relative;
  z-index: 1;
  outline: 2px solid var(--hardware-accent, var(--cyan));
  outline-offset: -2px;
  background-color: #cde6e6;
  box-shadow: inset 0 0 0 1px var(--hardware-accent, var(--cyan));
}

.channel.armed .channel-label {
  color: #10262b;
}

.sideview-load {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 5px;
}

.sideview-load button {
  min-width: 0;
  padding: 5px 2px;
  font-size: 8px;
}

