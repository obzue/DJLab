const MILLISECONDS_PER_DEGREE = 5;
export const TURNTABLE_DEGREES_PER_SECOND = 1000 / MILLISECONDS_PER_DEGREE;

export class ScratchableTurntableEngine {
  constructor(platter, tonearm) {
    this.platter = platter;
    this.tonearm = tonearm;
  }

  angleAtPlayback(positionSeconds, phaseOffset = 0) {
    return phaseOffset + Math.max(0, positionSeconds) * TURNTABLE_DEGREES_PER_SECOND;
  }

  setPlatterAngle(angle) {
    this.platter.style.setProperty('--jog-angle', angle + 'deg');
  }

  setNeedlePosition(positionSeconds, durationSeconds, skinId) {
    const position = Number.isFinite(positionSeconds) ? Math.max(0, positionSeconds) : 0;
    const duration = Number.isFinite(durationSeconds) ? Math.max(0, durationSeconds) : 0;
    const progress = duration > 0 ? Math.min(1, position / duration) : 0;
    const [startAngle, endAngle] = skinId === 'studio-tonearm' ? [0, 20] : [18, 48];
    this.tonearm.style.setProperty('--tonearm-angle', (startAngle + (endAngle - startAngle) * progress) + 'deg');
    return progress;
  }
}

