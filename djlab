    cyber: { body: '#003547', deck: '#001a24', mixer: '#002633', blue: '#fee715', green: '#10bcc9' },
    crimson: { body: '#360101', deck: '#1a0000', mixer: '#260000', blue: '#ff0000', green: '#ff7777' }
  },
  decks: {} // Hydrated programmatically
};

/**
 * HARDWARE MIXER CHANNEL COMPONENT CONSTRUCTOR
 */
class MixerChannel {
  constructor(id, initialVolume = 0) {
    this.id = id;
    this.dom = null;
    this.buildDom(initialVolume);
  }

  buildDom(vol) {
    const strip = document.createElement('div');
    strip.className = 'channel-strip';
    strip.id = `ch-strip-${this.id}`;
    strip.innerHTML = `
      <div class="ch-label">CH ${this.id}</div>
      <div class="knob-container"><div class="knob" data-eq="trim"></div><div class="knob-label">Trim</div></div>
      <div class="knob-container"><div class="knob" data-eq="hi"></div><div class="knob-label">Hi</div></div>
      <div class="knob-container"><div class="knob" data-eq="mid"></div><div class="knob-label">Mid</div></div>
      <div class="knob-container"><div class="knob" data-eq="low"></div><div class="knob-label">Low</div></div>
      <div class="knob-container"><div class="knob" data-eq="filter"></div><div class="knob-label">Filter</div></div>
      <button class="ch-cue-btn" id="cue-route-${this.id}">CUE</button>
      <div class="vu-meter-container"><div class="vu-meter-bar" id="vu-meter-${this.id}"></div></div>
      <div class="fader-wrapper"><input type="range" class="v-fader" min="0" max="100" value="${vol}" id="volume-fader-${this.id}"></div>
    `;
    
    // Connect pre-listen route state directly
    strip.querySelector('.ch-cue-btn').addEventListener('click', (e) => {
      e.target.classList.toggle('active');
    });

    this.dom = strip;
  }
}

/**
 * RUNTIME DJ CONTROLLER SUB-ENGINE
 */
const DJController = {
  init() {
    this.setupMixerStrips();
    this.bindPhysicalDecks();
    this.bindGlobalControls();
    this.initRotarySystem();
    this.startTelemetryVU();
  },

  setupMixerStrips() {
    const root = document.getElementById('mixer-strips-root');
    // Instantiating order standard channels layout matching HTML positioning framework
    const channelOrder = [1, 3, 4, 2];
    channelOrder.forEach(chId => {
      const defaultVol = (chId === 1 || chId === 2) ? 80 : 0;
      const channel = new MixerChannel(chId, defaultVol);
      root.appendChild(channel.dom);
    });
  },

  bindPhysicalDecks() {
    document.querySelectorAll('.deck').forEach(deckEl => {
      const id = parseInt(deckEl.getAttribute('data-deck-id'));
      
      // Instantiate configuration map profile per target wing structure
      DJStudio.decks[id] = {
        loaded: false,
        playing: false,
        padMode: 'hotcue',
        baseBPM: id === 1 ? 124.0 : id === 2 ? 130.0 : id === 3 ? 126.0 : 128.0,
        dom: deckEl
      };

      this.wireDeckInteractions(id, deckEl);
    });
  },

  wireDeckInteractions(id, el) {
    const state = DJStudio.decks[id];

    // Transport bindings
    el.querySelector('.btn-play').addEventListener('click', () => this.togglePlay(id));
    el.querySelector('.btn-cue').addEventListener('click', () => this.triggerCue(id));
    el.querySelector('.btn-sync').addEventListener('click', () => this.triggerSync(id));

    // Pitch slider logic
    el.querySelector('.tempo-slider').addEventListener('input', (e) => {
      const mod = parseFloat(e.target.value);
      const dynamicBPM = state.baseBPM * (1 + (mod / 100));
      el.querySelector('.bpm-value-display').innerText = `BPM: ${dynamicBPM.toFixed(2)}`;
    });

    // Loop array delegation
    el.querySelector('.loop-strip').addEventListener('click', (e) => {
      const type = e.target.getAttribute('data-loop');
      if(!type) return;
      
      el.querySelectorAll('.loop-btn').forEach(b => b.classList.remove('active'));
      if (type !== 'clear') {
        e.target.classList.add('active');
        el.querySelector('.track-status-readout').innerText = `LOOP ACTIVE: ${type} BEATS`;
      } else {
        el.querySelector('.track-status-readout').innerText = `LOOP TERMINATED`;
      }
    });

    // Pad mode matrices selectors
    el.querySelector('.pad-modes').addEventListener('click', (e) => {
      const mode = e.target.getAttribute('data-mode');
      if(!mode) return;
      el.querySelectorAll('.pad-mode-btn').forEach(b => b.classList.remove('active'));
      e.target.classList.add('active');
      state.padMode = mode;
    });

    // Matrix action hits trigger
    el.querySelector('.drum-pads-matrix').addEventListener('mousedown', (e) => {
      const pad = e.target.getAttribute('data-pad');
      if(!pad) return;
      e.target.classList.add('triggered');
      
      const readout = el.querySelector('.track-status-readout');
      readout.innerText = DJStudio.shiftModifier 
        ? `RESET: ${state.padMode.toUpperCase()} #${pad}`
        : `TRIGGER: ${state.padMode.toUpperCase()} #${pad}`;
    });

    el.querySelector('.drum-pads-matrix').addEventListener('mouseup', (e) => {
      if(e.target.classList.contains('drum-pad')) e.target.classList.remove('triggered');
    });

    // Jog wheels tactile triggers
    const jog = el.querySelector('.jog-wheel');
    // ensure jog element has a stable id so audio module can toggle spinning (audio.js / audio.playDeck expects jog-<id>)
    try { if (jog && !jog.id) jog.id = `jog-${id}`; } catch(e){ /* ignore */ }
    ['mousedown', 'touchstart'].forEach(ev => jog.addEventListener(ev, () => jog.classList.add('triggered')));
    ['mouseup', 'mouseleave', 'touchend'].forEach(ev => jog.addEventListener(ev, () => jog.classList.remove('triggered')));
  },

  bindGlobalControls() {
    // Shift Key System
    const shiftBtn = document.getElementById('hardware-shift-modifier');
    const setShift = (val) => {
      DJStudio.shiftModifier = val;
      shiftBtn.classList.toggle('active', val);
    };
    shiftBtn.addEventListener('mousedown', () => setShift(true));
    shiftBtn.addEventListener('mouseup', () => setShift(false));
    shiftBtn.addEventListener('mouseleave', () => setShift(false));

    // Disk Storage File Loading Matrix
    document.getElementById('sandbox-audio-picker').addEventListener('change', (e) => {
      const files = e.target.files;
      if(files.length === 0) return;
      
      const list = document.getElementById('sandbox-file-list');
      if(DJStudio.inventory.length === 0) list.innerHTML = '';

      Array.from(files).forEach(file => {
        DJStudio.inventory.push(file);
        const index = DJStudio.inventory.length - 1;
        const item = document.createElement('div');
        item.className = 'track-item';
        item.id = `track-item-${index}`;
        item.innerHTML = `
          <span style="white-space:nowrap; overflow:hidden; text-overflow:ellipsis; width:120px;">🎵 ${file.name}</span>
          <div>
            <button class="load-btn" data-load="1">L1</button>
            <button class="load-btn" data-load="3">L3</button>
            <button class="load-btn" data-load="4">L4</button>
            <button class="load-btn" data-load="2">L2</button>
          </div>
        `;
        list.appendChild(item);
      });
    });

    // Interactive dynamic deck loading routing matrix via browser click
    document.getElementById('sandbox-file-list').addEventListener('click', (e) => {
      const targetDeck = e.target.getAttribute('data-load');
      if(!targetDeck) return;
      const itemEl = e.target.closest('.track-item');
      const idx = parseInt(itemEl.id.split('-')[2]);
      this.loadTrackToDeck(idx, parseInt(targetDeck));
    });

    // Themes event routing
    document.getElementById('theme-presets-container').addEventListener('click', (e) => {
      const themeKey = e.target.getAttribute('data-theme');
      if(themeKey) this.applyTheme(DJStudio.themes[themeKey]);
    });

    document.getElementById('custom-theme-apply-trigger').addEventListener('click', () => {
      this.applyTheme({
        body: document.getElementById('cp-chassis').value,
        deck: document.getElementById('cp-deck').value,
        mixer: document.getElementById('cp-mixer').value,
        blue: document.getElementById('cp-accent').value,
        green: document.getElementById('cp-green').value
      });
    });
  },

  loadTrackToDeck(fileIdx, deckId) {
    const track = DJStudio.inventory[fileIdx];
    const state = DJStudio.decks[deckId];
    if(!state) return;

    state.loaded = true;
    const readout = state.dom.querySelector('.track-status-readout');
    readout.innerText = `LOADED: ${track.name}`;
    readout.style.color = 'var(--accent-green)';
    this.syncPlatterAnimation(deckId);
  },

  togglePlay(id) {
    const state = DJStudio.decks[id];
    if(!state.loaded) return alert(`Deck ${id} requires audio loaded.`);

    state.playing = !state.playing;
    const playBtn = state.dom.querySelector('.btn-play');
    playBtn.classList.toggle('active', state.playing);
    playBtn.innerText = state.playing ? "PAUSE" : "PLAY";

    this.syncPlatterAnimation(id);
  },

  triggerCue(id) {
    const state = DJStudio.decks[id];
    if(!state.loaded) return;

    const cueBtn = state.dom.querySelector('.btn-cue');
    cueBtn.classList.add('active');
    setTimeout(() => cueBtn.classList.remove('active'), 150);

    state.playing = false;
    const playBtn = state.dom.querySelector('.btn-play');
    playBtn.classList.remove('active');
    playBtn.innerText = "PLAY";

    this.syncPlatterAnimation(id);
  },

  triggerSync(id) {
    const state = DJStudio.decks[id];
    if(!state.loaded) return;

    state.baseBPM = 128.00;
    state.dom.querySelector('.bpm-value-display').innerText = `BPM: 128.00`;
    const syncBtn = state.dom.querySelector('.btn-sync');
    syncBtn.classList.add('active');
    setTimeout(() => syncBtn.classList.remove('active'), 400);
  },

  syncPlatterAnimation(id) {
    const state = DJStudio.decks[id];
    const wheel = state.dom.querySelector('.jog-wheel');
    
    // Strict Operational Condition: ONLY spinning updates apply onto Decks 1 & 2 directly
    if((id === 1 || id === 2) && state.loaded && state.playing) {
      wheel.classList.add('spinning');
    } else {
      wheel.classList.remove('spinning');
    }
  },

  initRotarySystem() {
    // Browser hardware encoder wheel engine turn logic
    const encoder = document.getElementById('hardware-browser-encoder');
    let totalRot = 0;

    encoder.addEventListener('mousedown', (e) => {
      let startY = e.clientY;
      encoder.classList.add('active-tuning');
      
      const moveTrack = (moveEvent) => {
        if(DJStudio.inventory.length === 0) return;
        let delta = startY - moveEvent.clientY;
        
        if (Math.abs(delta) > 15) {
          totalRot += delta > 0 ? 30 : -30;
          encoder.style.transform = `rotate(${totalRot}deg)`;
          
          document.querySelectorAll('.track-item').forEach(el => el.style.background = 'rgba(255,255,255,0.03)');
          DJStudio.activeIndex = (DJStudio.activeIndex + (delta > 0 ? 1 : -1) + DJStudio.inventory.length) % DJStudio.inventory.length;
          
          const targetedRow = document.getElementById(`track-item-${DJStudio.activeIndex}`);
          if(targetedRow) {
            targetedRow.style.background = 'rgba(0, 242, 254, 0.2)';
            document.getElementById('encoder-label').innerText = `Selected: #${DJStudio.activeIndex + 1}`;
          }
          startY = moveEvent.clientY;
        }
      };

      const stopTrack = () => {
        encoder.classList.remove('active-tuning');
        document.removeEventListener('mousemove', moveTrack);
        document.removeEventListener('mouseup', stopTrack);
      };

      document.addEventListener('mousemove', moveTrack);
      document.addEventListener('mouseup', stopTrack);
    });

    // Consolidated analog knobs mouse gestures capture system
    document.addEventListener('mousedown', (e) => {
      const knob = e.target.closest('.knob');
      if(!knob || knob.id === 'hardware-browser-encoder') return;

      knob.classList.add('active-tuning');
      let currentY = e.clientY;
      let currentRot = Object.values(DJStudio.decks).reduce(() => {
        const match = knob.style.transform.match(/rotate\(([^deg)]+)/);
        return match ? parseInt(match[1]) : 0;
      }, 0);

      const trackMouse = (moveEv) => {
        let diff = currentY - moveEv.clientY;
