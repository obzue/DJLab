export function togglePlay(deckId, btnEl){
  try{
    const id = Number(deckId);
    const deck = decks[id];
    if(!deck) return;
    // resolve button element if not provided (support both panel-deck- and deck-container- prefixes)
    let btn = null;
    if(btnEl && typeof btnEl === 'object') btn = btnEl;
    else {
      btn = document.querySelector(`#panel-deck-${id} .btn-play`) || document.querySelector(`#deck-container-${id} .btn-play`);
    }

    if(deck.playing){
      // Stop playback
      stopDeck(deck);
      if(btn){ btn.classList.remove('active'); btn.innerText = 'PLAY'; }
      const disp = document.getElementById(`deck-display-${id}`) || document.querySelector(`#panel-deck-${id} .track-status-readout`);
      if(disp) { disp.innerText = `Stopped`; disp.style.color=''; }
    } else {
      // Start playback (resume audio context if suspended)
      if(ctx && ctx.state === 'suspended') ctx.resume().catch(()=>{});
      playDeck(deck);
      if(btn){ btn.classList.add('active'); btn.innerText = 'PAUSE'; }
      const disp = document.getElementById(`deck-display-${id}`) || document.querySelector(`#panel-deck-${id} .track-status-readout`);
      if(disp) { disp.innerText = `Playing`; disp.style.color='var(--accent-green)'; }
    }
    // re-evaluate routing so gains/crossfade apply immediately
    updateRouting();
  }catch(err){
    console.warn('togglePlay error', err);
  }
}
