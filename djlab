export async function initExternalControllers(){
  // MIDI
  if(navigator.requestMIDIAccess){
    try{
      const midi = await navigator.requestMIDIAccess({ sysex:false });
      midi.inputs.forEach(input=>{
        input.onmidimessage = (msg)=>{
          const [status, data1, data2] = msg.data;
          const type = status & 0xf0;
          if(type === 0x90 && data2>0){
            const padIndex = (data1 % 16) + 1;
            const deckNum = 1;
            const pad = document.querySelector(`#deck-container-${deckNum} .drum-pad[data-pad="${padIndex}"]`);
            if(pad) { pad.classList.add('playing'); setTimeout(()=>pad.classList.remove('playing'),120); }
          } else if(type === 0xB0){
            if(data1 === 7) { const f = document.getElementById('fader-1'); if(f) { f.value = Math.round((data2/127)*100); updateRouting(); } }
            else if(data1 === 8){ const f = document.getElementById('fader-2'); if(f) { f.value = Math.round((data2/127)*100); updateRouting(); } }
            else if(data1 === 16){ const cf = document.getElementById('hardware-crossfader'); if(cf) { cf.value = Math.round((data2/127)*200 - 100); updateRouting(); } }
          }
        };
      });
    }catch(err){ console.warn('MIDI init failed:', err); }
  }

  // WebHID
  if(navigator.hid){
    try{
      const devices = await navigator.hid.getDevices();
      devices.forEach(async dev=>{
        try{
          if(!dev.opened) await dev.open();
          dev.addEventListener('inputreport', e=>{
            const view = e.data; if(view && view.byteLength){
              const b = new Uint8Array(view.buffer)[0];
              const cf = document.getElementById('hardware-crossfader');
              if(cf) { cf.value = Math.round((b/255)*200 - 100); updateRouting(); }
            }
          });
        }catch(err){ console.warn('HID device open failed', err); }
      });
    }catch(err){ console.warn('HID init failed:', err); }
  }

  // Keyboard shortcuts minimal
  window.addEventListener('keydown', (ev)=>{
    if(ev.code === 'Space'){ document.querySelector('#deck-container-1 .btn-play')?.click(); ev.preventDefault(); }
    else if(ev.code === 'Digit2') document.querySelector('#deck-container-2 .btn-play')?.click();
    else if(ev.code === 'Digit3') document.querySelector('#deck-container-3 .btn-play')?.click();
    else if(ev.code === 'Digit4') document.querySelector('#deck-container-4 .btn-play')?.click();
  });
}

export function attachJogSafe(jogIdOrEl, deck, waveformId){
  // jogIdOrEl can be an element, an id string, or a deck DOM element; fallback to searching inside deck
  let jog = null;
  if(typeof jogIdOrEl === 'string') jog = document.getElementById(jogIdOrEl);
  else if(jogIdOrEl instanceof Element) jog = jogIdOrEl;
  if(!jog && deck && deck.id) {
    // try find jog inside deck DOM element (panel-deck-<id> or deck-container-<id>)
    const deckEl = document.querySelector(`#panel-deck-${deck.id}, #deck-container-${deck.id}`);
    if(deckEl) jog = deckEl.querySelector('.jog-wheel');
  }
  if(!jog || !deck) return;
  let lastY = null;
  function start(e){ e.preventDefault(); lastY = (e.touches ? e.touches[0].clientY : e.clientY); jog.classList.add('active'); }
  function move(e){
    if(lastY===null) return;
    const y = (e.touches ? e.touches[0].clientY : e.clientY);
    const dy = y - lastY; lastY = y;
    deck.pausedAt = Math.max(0, (deck.pausedAt || 0) + dy * 0.02);
    if(deck.playing) { playDeck(deck); }
  }
  function end(){ lastY=null; jog.classList.remove('active'); }
  jog.addEventListener('mousedown', start); jog.addEventListener('touchstart', start);
  window.addEventListener('mousemove', move); window.addEventListener('touchmove', move);
  window.addEventListener('mouseup', end); window.addEventListener('touchend', end);
}

export function initPadHandlers(){
  // sample pool handling and local file broker wiring
  let localSandboxTracks = [];
  let activeSamplePending = null;

  const broker = document.getElementById('local-file-broker');
  if(broker){
    broker.addEventListener('change', function(e) {
      const files = e.target.files;
      if (files.length === 0) return;
      const poolContainer = document.getElementById('track-pool-list');
      if(localSandboxTracks.length === 0 && poolContainer) poolContainer.innerHTML = '';
      for(let file of files) {
        localSandboxTracks.push(file);
        const index = localSandboxTracks.length - 1;
        if(!poolContainer) continue;
        const trackRow = document.createElement('div');
        trackRow.className = 'track-item';
        trackRow.innerHTML = `
          <span>🎵 ${file.name}</span>
          <div class="load-btn-group">
            <button class="load-btn" data-idx="${index}" data-deck="1">L1</button>
            <button class="load-btn" data-idx="${index}" data-deck="3">L3</button>
            <button class="load-btn" data-idx="${index}" data-deck="4">L4</button>
            <button class="load-btn" data-idx="${index}" data-deck="2">L2</button>
            <button class="load-btn pad-target" data-idx="${index}" data-padassign>PAD</button>
          </div>
        `;
        poolContainer.appendChild(trackRow);
      }
      // attach new handlers for load buttons
      poolContainer.querySelectorAll('.load-btn').forEach(b=>{
        b.addEventListener('click', async (ev)=>{
          const idx = Number(b.dataset.idx);
          const deckId = Number(b.dataset.deck) || 1;
          const file = localSandboxTracks[idx];
          if(!file) return;
          try {
            const buf = await decodeFile(file);
            if(!buf) throw new Error('Decoded buffer empty');
            if(decks[deckId]) {
              decks[deckId].audioBuffer = buf;
              decks[deckId].pausedAt = 0;
              const canvas = document.getElementById(`waveform-${deckId}`);
              if(canvas) drawWave(canvas, buf);
            }
            const display = document.getElementById(`deck-display-${deckId}`);
            if(display){ display.innerText = `LOADED: ${file.name}`; display.style.color = '#00ff87'; }
          } catch (err) {
            console.warn('File load/decode failed:', err);
            const display = document.getElementById(`deck-display-${deckId}`);
            if(display){ display.innerText = `Load error: ${err.message || 'decode failed'}`; display.style.color = '#ff6b6b'; }
            else alert('Failed to load track: ' + (err.message || 'decode error'));
          }
        });
      });
    });
  }

  // pad mapping UI: clicking a sample in the sample pool will arm it for next pad click
  document.querySelectorAll('#sample-pool-list .track-item').forEach(item=>{
    item.addEventListener('click', ()=>{
      const name = item.textContent.trim();
      activeSamplePending = { type:'sample', name, file: null };
      const hint = document.getElementById('pad-target-indicator');
      if(hint) hint.style.visibility = 'visible';
      document.querySelectorAll('#sample-pool-list .track-item').forEach(i=>i.style.background='');
      item.style.background='rgba(0,255,135,0.15)';
    });

    // support dragging an actual file from desktop into sample pool items (drop to assign)
    item.addEventListener('dragover', (e)=>{ e.preventDefault(); item.classList.add('hover'); });
    item.addEventListener('dragleave', ()=>{ item.classList.remove('hover'); });
    item.addEventListener('drop', async (e)=>{
      e.preventDefault(); item.classList.remove('hover');
      const f = e.dataTransfer.files?.[0];
      if(!f) return;
      // decode and store as a "local sample" row
      try {
        const buf = await decodeFile(f);
        const poolContainer = document.getElementById('sample-pool-list');
        const row = document.createElement('div');
        row.className = 'track-item';
        row.textContent = `🎧 ${f.name}`;
        row.dataset.sampleName = f.name;
        row.dataset.sampleIdx = Date.now().toString();
        row._buffer = buf;
        // clicking assigns to next pad
        row.addEventListener('click', ()=>{
          activeSamplePending = { type:'sample', name: f.name, buffer: buf };
          const hint = document.getElementById('pad-target-indicator'); if(hint) hint.style.visibility='visible';
          document.querySelectorAll('#sample-pool-list .track-item').forEach(i=>i.style.background='');
          row.style.background='rgba(0,255,135,0.15)';
        });
        poolContainer.appendChild(row);
      } catch(err){ console.warn('Sample decode failed', err); }
    });
  });

  // Allow dropping files directly onto pads to map as pad-sample
  document.querySelectorAll('.drum-pad').forEach(pad=>{
    // storage: pad._sampleBuffer and pad._sampleName
    pad.addEventListener('dragover', (e)=>{ e.preventDefault(); pad.classList.add('hover'); });
    pad.addEventListener('dragleave', ()=>{ pad.classList.remove('hover'); });
    pad.addEventListener('drop', async (e)=>{
      e.preventDefault(); pad.classList.remove('hover');
      const f = e.dataTransfer.files?.[0];
      if(!f) return;
      try {
        const buf = await decodeFile(f);
        pad._sampleBuffer = buf;
        pad._sampleName = f.name;
        pad.classList.add('loaded');
        pad.title = `Loaded sample: ${f.name}`;
        pad.innerHTML = `${pad.getAttribute('data-pad')}*`;
        pad.style.color = 'var(--accent-green)';
      } catch(err){
        console.warn('Pad drop decode failed', err);
      }
    });

    pad.addEventListener('click', async function(){
      const padNum = this.getAttribute('data-pad');
      // If a sample was armed from pool, assign it to this pad
      if(activeSamplePending && activeSamplePending.buffer){
        this._sampleBuffer = activeSamplePending.buffer;
        this._sampleName = activeSamplePending.name;
        this.classList.add('loaded');
        this.title = `Loaded: ${activeSamplePending.name}`;
        this.innerHTML = `P${padNum}*`;
        this.style.color = 'var(--accent-green)';
        activeSamplePending = null;
        const hint = document.getElementById('pad-target-indicator'); if(hint) hint.style.visibility='hidden';
        document.querySelectorAll('#sample-pool-list .track-item').forEach(i=>i.style.background='');
        return;
      }

      // If pad has its own loaded sample buffer, play it via the deck channel gain if possible
      if(this._sampleBuffer){
        try {
          // use imported ctx
          const src = ctx.createBufferSource();
          src.buffer = this._sampleBuffer;
          // map to the nearest deck for playback preview: find closest deck id in DOM or default to 1
          const parentDeckAttr = this.closest('.deck')?.getAttribute('data-deck-id');
          const parentDeck = parentDeckAttr ? Number(parentDeckAttr) : 1;
          const deckObj = decks[parentDeck] || null;
          if(deckObj && deckObj.gain && deckObj.gain.connect) {
            src.connect(deckObj.gain);
          } else {
            src.connect(master.node);
          }
          src.start(0);
          this.classList.add('playing'); setTimeout(()=>this.classList.remove('playing'),150);
        } catch(err){
          console.warn('Pad play failed', err);
        }
        return;
      }

      // If nothing is loaded and no sample pending, show a quick blink to indicate empty pad
      this.classList.add('playing'); setTimeout(()=>this.classList.remove('playing'),150);
    });
  });
}

/* New: knob handling for channel EQ (drag vertically to adjust gain) */
export function initKnobs(){
  const knobs = document.querySelectorAll('.knob');
  knobs.forEach(knob=>{
    let startY = 0, startRot = 0;
    const type = knob.dataset.type || 'mid';
    function clamp(v,min,max){ return Math.max(min, Math.min(max, v)); }
    function onDown(e){
      e.preventDefault();
      startY = (e.touches ? e.touches[0].clientY : e.clientY);
      // read current rotation from style transform if present
      const m = knob.style.transform.match(/rotate\((-?\\d+)deg\)/);
      startRot = m ? Number(m[1]) : 0;
      window.addEventListener('mousemove', onMove);
      window.addEventListener('touchmove', onMove, { passive:false });
      window.addEventListener('mouseup', onUp);
      window.addEventListener('touchend', onUp);
    }
    function onMove(e){
      e.preventDefault();
      const y = (e.touches ? e.touches[0].clientY : e.clientY);
      const dy = startY - y;
      const newRot = clamp(startRot + dy * 0.5, -60, 60);
      knob.style.transform = `rotate(${newRot}deg)`;
      // compute gain range -12 to +12 dB based on rotation
      const gain = (newRot / 60) * 12;
      // find channel strip and ch-label to map to deck
      const channel = knob.closest('.channel-strip');
      const label = channel ? channel.querySelector('.ch-label')?.innerText || '' : '';
      const chMatch = label.match(/CH\s*(\d)/);
      let deckId = chMatch ? Number(chMatch[1]) : null;
      // mapping: CH1->1, CH2->2, CH3->3, CH4->4 (consistent with channel labels)
      if(deckId && decks[deckId]){
        const deck = decks[deckId];
        // apply to the corresponding filter type
        if(type === 'hi') deck.eq.high.gain.value = gain;
        else if(type === 'mid') { deck.eq.mid.gain.value = gain; deck.eq.mid.Q = 1; }
        else if(type === 'low') deck.eq.low.gain.value = gain;
        else if(type === 'fx') {
          // fx knob: map to overall deck.gain
          deck.gain.gain.value = clamp((gain + 12) / 24, 0, 2);
        }
      }
    }
    function onUp(){
      window.removeEventListener('mousemove', onMove);
      window.removeEventListener('touchmove', onMove);
      window.removeEventListener('mouseup', onUp);
      window.removeEventListener('touchend', onUp);
    }
    knob.addEventListener('mousedown', onDown);
    knob.addEventListener('touchstart', onDown, { passive:false });
  });
}

