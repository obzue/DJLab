// small waveform renderer
export function drawWave(canvas, buffer){
  if(!canvas) return;
  const w = canvas.width = canvas.clientWidth;
  const h = canvas.height = canvas.clientHeight;
  const ctx2 = canvas.getContext('2d');
  ctx2.clearRect(0,0,w,h);
  if(!buffer) return;
  const data = buffer.getChannelData(0);
  const step = Math.ceil(data.length / w);
  ctx2.fillStyle = '#0b0c0d';
  ctx2.fillRect(0,0,w,h);
  ctx2.fillStyle = 'rgba(255,107,74,0.85)';
  for(let i=0;i<w;i++){
    let min=1, max=-1;
    for(let j=0;j<step;j++){
      const v = data[(i*step)+j];
      if(v<min)min=v; if(v>max)max=v;
    }
    const y1 = (1+min) * 0.5 * h;
    const y2 = (1+max) * 0.5 * h;
    ctx2.fillRect(i, h - y2, 1, Math.max(1, y2 - y1));
  }
}

async function handleDrop(deck, file, canvas){
  try {
    const buffer = await decodeFile(file);
    if(!buffer) throw new Error('Decoded buffer is empty');
    deck.audioBuffer = buffer;
    deck.pausedAt = 0;
    drawWave(canvas, buffer);
    updateRouting();
  } catch (err) {
    console.warn('handleDrop decode error:', err);
    const disp = document.getElementById(`deck-display-${deck?.id || '?'}`);
    if(disp){
      disp.innerText = `Load error: ${err.message || 'Unable to decode audio'}`;
      disp.style.color = '#ff6b6b';
    } else {
      alert('Unable to decode audio file. Your browser may not support the file format.');
    }
  }
}

export function attachDropZones(deckMap){
  // dynamically wire drop zones for up to 4 decks; fall back to central file broker if deck not present
  for(let i=1;i<=4;i++){
    const zone = document.getElementById(`drop-zone-${i}`);
    const canvas = document.getElementById(`waveform-${i}`);
    const deck = deckMap[i];
    if(!zone || !canvas || !deck) continue;
    ['dragenter','dragover'].forEach(e=> zone.addEventListener(e, ev => { ev.preventDefault(); zone.classList.add('hover'); }));
    ['dragleave','drop'].forEach(e=> zone.addEventListener(e, ev => { ev.preventDefault(); zone.classList.remove('hover'); }));
    zone.addEventListener('drop', async ev=>{
      const f = ev.dataTransfer.files?.[0];
      if(!f) return;
      await handleDrop(deck, f, canvas);
    });
    zone.addEventListener('click', async ()=>{
      const input = document.createElement('input'); input.type='file'; input.accept='audio/*';
      input.onchange = async (ev)=>{ const f = ev.target.files?.[0]; if(f) await handleDrop(deck,f,canvas); };
      input.click();
    });
  }

  // If a central file-broker exists, make it load into a selected deck when clicking a pool load button.
  // The more advanced pool wiring remains in controllers.js where track loading UI is handled.
}

export function wireTransportButtons(){
  document.querySelectorAll('.deck').forEach(deckEl=>{
    deckEl.querySelectorAll('.transport-strip .btn').forEach(btn=>{
      btn.addEventListener('click', async (e)=>{
        // try resume audio context safely (use imported audio ctx if available)
        try {
          if(window && window.AudioContext && window.audio && window.audio.ctx && window.audio.ctx.state === 'suspended') {
            await window.audio.ctx.resume();
          } else {
            // try global ctx reference if present
            if(window && window.ctx && window.ctx.state === 'suspended') await window.ctx.resume();
          }
        } catch(e){ /* ignore resume failures */ }

        // support both panel-deck- and deck-container- ids
        const idMatch = deckEl.id.match(/(?:panel-deck|deck-container)-?(\d+)/);
        const deckID = idMatch ? Number(idMatch[1]) : 1;

        if(btn.classList.contains('btn-play')) {
          // toggle simple UI state; actual audio play handled elsewhere (controllers)
          if(btn.classList.contains('active')) {
            btn.classList.remove('active'); btn.innerText='PLAY';
          } else { btn.classList.add('active'); btn.innerText='PAUSE'; }
        } else {
          // stop UI
          btn.parentElement.querySelector('.btn-play')?.classList.remove('active');
        }
      });
    });
  });
}

export function makeWaveHiDPI(){
  document.querySelectorAll('.waveform').forEach(c=>{
    const dpr = window.devicePixelRatio || 1;
    c.width = c.clientWidth * dpr;
    c.height = c.clientHeight * dpr;
    c.getContext('2d').scale(dpr,dpr);
  });
}

/* Toggle/hide Deck UI wiring */
export function addDeckToggleButtons(updateRoutingFn){
  const btn3 = document.getElementById('toggle-deck-3');
  const btn4 = document.getElementById('toggle-deck-4');

  function toggleDeck(deckId, btn){
    const el = document.getElementById(`deck-container-${deckId}`);
    if(!el) return;
    const hidden = el.classList.toggle('hidden');
    if(hidden){
      btn.innerText = `Show Deck ${deckId}`;
      // if routing function provided, call to re-evaluate levels when hidden
      if(typeof updateRoutingFn === 'function') updateRoutingFn();
    } else {
      btn.innerText = `Hide Deck ${deckId}`;
      if(typeof updateRoutingFn === 'function') updateRoutingFn();
    }
  }

  if(btn3) btn3.addEventListener('click', ()=> toggleDeck(3, btn3));
  if(btn4) btn4.addEventListener('click', ()=> toggleDeck(4, btn4));
}

/* Sandbox scroll helper: enable drag-to-scroll and wheel smoothing for pool lists */
export function addSandboxScroll(){
  ['track-pool-list','sample-pool-list'].forEach(id=>{
    const el = document.getElementById(id);
    if(!el) return;
    // wheel: slow smooth vertical scroll
    el.addEventListener('wheel', (e)=>{
      e.preventDefault();
      el.scrollBy({ top: e.deltaY, behavior: 'auto' });
    }, { passive:false });

    // drag-to-scroll (pointer)
    let isDown = false, startY=0, startScroll=0;
    el.addEventListener('pointerdown', (ev)=>{
      isDown = true; startY = ev.clientY; startScroll = el.scrollTop; el.setPointerCapture(ev.pointerId);
    });
    window.addEventListener('pointermove', (ev)=>{
      if(!isDown) return;
      const dy = startY - ev.clientY;
      el.scrollTop = startScroll + dy;
    });
    window.addEventListener('pointerup', ()=>{ isDown=false; });
  });
}                                                                          
