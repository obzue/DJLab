 */
const DJStudio = {
  inventory: [],
  activeIndex: -1,
  shiftModifier: false,
  themes: {
    nexus: { body: '#1f2833', deck: '#121212', mixer: '#1a1a1a', blue: '#00f2fe', green: '#00ff87' },
    stealth: { body: '#111111', deck: '#181818', mixer: '#151515', blue: '#ffffff', green: '#555555' },
    toxic: { body: '#1a2416', deck: '#0d1109', mixer: '#121a0e', blue: '#39ff14', green: '#ccff00' },
    neon: { body: '#2b003a', deck: '#14001c', mixer: '#1f002a', blue: '#ff007f', green: '#00ffff' },
    glacier: { body: '#3a4f5c', deck: '#1e2930', mixer: '#27353f', blue: '#a5f3fc', green: '#38bdf8' },
    sunset: { body: '#4c1d24', deck: '#240e11', mixer: '#341419', blue: '#ff5722', green: '#ffb703' },
    monochrome: { body: '#4a4a4a', deck: '#2b2b2b', mixer: '#333333', blue: '#e5e5e5', green: '#a3a3a3' },
